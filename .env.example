# ── Veritabanı ─────────────────────────────────────────────
# Üretim (Supabase projesinin Connection string'inden)
# Şifrede özel karakterler varsa URL-encoded olmalı (örn. / → %2F)
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres

# ── Oturum güvenliği ───────────────────────────────────────
# En az 32 karakterlik rastgele değer (örn. openssl rand -hex 32)
AUTH_SECRET=degistir_beni

# ── Seed scripti (npm run db:seed) ─────────────────────────
# İlk yönetici hesabı; ilk girişten sonra panelde değiştirin.
ADMIN_EMAIL=yonetici@ozturkguvenlik.com
ADMIN_PASSWORD=degistir_beni
ADMIN_NAME=Recep Özkan Öztürk
ADMIN_PHONE=05350146593

# ── Dosya depolama (ürün görselleri, taranan faturalar, iş/servis
#    fotoğrafları) ────────────────────────────────────────
# Vercel projesine bir Blob deposu bağlanınca otomatik eklenir
# (Vercel Dashboard → Storage → Blob) — elle girmeye gerek yoktur.
BLOB_READ_WRITE_TOKEN=

# ── Zamanlanmış görevler (Vercel Cron) ─────────────────────
# Cron uçlarını (bkz. vercel.json) dışarıdan tetiklenmeye karşı korur.
# Boş bırakılırsa kontrol atlanır (yalnızca local/dev için kabul edilebilir).
CRON_SECRET=degistir_beni

# ── E-posta bildirimleri (Resend, resend.com) ──────────────
# Boş bırakılırsa bildirimler sessizce atlanır, uygulama e-postasız da çalışır.
RESEND_API_KEY=
# Alan adı Resend'de doğrulanana kadar boş bırakılabilir (test göndereni kullanılır).
EMAIL_FROM="Öztürk Güvenlik <bildirim@ozturkguvenlik.com>"