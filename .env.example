# ── Veritabanı ─────────────────────────────────────────────
# Üretim (Supabase projesinin Connection string'inden)
# Şifrede özel karakterler varsa URL-encoded olmalı (örn. / → %2F)
# ÖNEMLİ: Vercel/serverless için PORT 6543 (Transaction pooler) kullanın,
# 5432 (Session pooler) DEĞİL — session modu serverless'ın çok sayıda kısa
# ömürlü eşzamanlı bağlantısı altında hızla tükenir (bkz. 2026-11-15
# panel çökmesi: iki kişi aynı anda giriş yapınca "server error").
# drizzle-orm/node-postgres adlandırılmış prepared statement kullanmadığı
# için transaction pooler ile tamamen uyumludur.
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres

# ── Oturum güvenliği ───────────────────────────────────────
# En az 32 karakterlik rastgele değer (örn. openssl rand -hex 32)
AUTH_SECRET=degistir_beni

# ── Seed scripti (npm run db:seed) ─────────────────────────
# İlk yönetici hesabı; ilk girişten sonra panelde değiştirin.
ADMIN_EMAIL=yonetici@ozturkguvenlik.com
ADMIN_PASSWORD=degistir_beni
ADMIN_NAME=Recep Özkan Öztürk
ADMIN_PHONE=05350146593

# ── Dosya depolama (ürün görselleri, taranan faturalar, iş/servis
#    fotoğrafları) ────────────────────────────────────────
# Vercel projesine bir Blob deposu bağlanınca otomatik eklenir
# (Vercel Dashboard → Storage → Blob) — elle girmeye gerek yoktur.
BLOB_READ_WRITE_TOKEN=

# ── Zamanlanmış görevler (Vercel Cron) ─────────────────────
# Cron uçlarını (bkz. vercel.json) dışarıdan tetiklenmeye karşı korur.
# Boş bırakılırsa kontrol atlanır (yalnızca local/dev için kabul edilebilir).
CRON_SECRET=degistir_beni

# ── E-posta bildirimleri (Resend, resend.com) ──────────────
# Boş bırakılırsa bildirimler sessizce atlanır, uygulama e-postasız da çalışır.
RESEND_API_KEY=
# Alan adı Resend'de doğrulanana kadar boş bırakılabilir (test göndereni kullanılır).
EMAIL_FROM="Öztürk Güvenlik <bildirim@ozturkguvenlik.com>"

# ── GİB fatura arşiv aktarımı (bkz. /panel/gib-faturalar) ──
# GİB'e ait bir kimlik bilgisi DEĞİL — yalnızca bookmarklet'ten gelen isteğin
# gerçekten bizim aracımızdan geldiğini doğrulayan, sitenin kendi sırrı.
# En az 32 karakterlik rastgele değer (örn. openssl rand -hex 32). Boş
# bırakılırsa aktarım uç noktası devre dışı kalır (503 döner).
GIB_IMPORT_TOKEN=
# Yalnızca bu adreslerden (Origin header) gelen tarayıcı istekleri kabul
# edilir. Gerçek GİB portal adresi netleşince güncellenmesi gerekebilir —
# varsayılan: https://earsivportal.efatura.gov.tr,https://portal.efatura.gov.tr
GIB_IMPORT_ALLOWED_ORIGINS=